# Application
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://reposcope:reposcope@db:5432/reposcope?sslmode=disable
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
HTTP_CLIENT_TIMEOUT=12s
CACHE_TTL=2m
SHUTDOWN_TIMEOUT=10s

# GitHub REST API. Token is optional; never commit a real value.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10

# PostgreSQL (development only; use secrets in production)
POSTGRES_DB=reposcope
POSTGRES_USER=reposcope
POSTGRES_PASSWORD=reposcope
