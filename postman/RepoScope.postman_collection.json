{
  "info": {
    "_postman_id": "65a12710-75b5-49fc-9ac8-reposcope-api",
    "name": "RepoScope API",
    "description": "Позитивные и негативные REST-сценарии RepoScope. Запускайте папки по порядку через Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
    "if (pm.response.code !== 204) { pm.test('Content-Type is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json')); }",
    "const id = pm.response.headers.get('X-Request-ID'); if (id) pm.environment.set('requestId', id);",
    "pm.test('Response time is below 10 s', () => pm.expect(pm.response.responseTime).to.be.below(10000));"
  ]}}],
  "item": [
    {"name":"01 System","item":[
      {"name":"Health — 200","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":"{{baseUrl}}/health"},"event":[{"listen":"test","script":{"exec":["pm.test('Status 200', () => pm.response.to.have.status(200));","const json=pm.response.json(); pm.test('Service is alive',()=>pm.expect(json.status).to.eql('ok'));"],"type":"text/javascript"}}]},
      {"name":"Ready — 200","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":"{{baseUrl}}/ready"},"event":[{"listen":"test","script":{"exec":["pm.test('Status 200', () => pm.response.to.have.status(200));","pm.test('Ready payload',()=>pm.expect(pm.response.json()).to.have.property('status','ready'));"],"type":"text/javascript"}}]},
      {"name":"GitHub rate limit — 200","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":"{{baseUrl}}/rate-limit"},"event":[{"listen":"test","script":{"exec":["pm.test('Status 200', () => pm.response.to.have.status(200));","const j=pm.response.json(); pm.test('Has core and search limits',()=>{pm.expect(j.core).to.have.property('remaining');pm.expect(j.search).to.have.property('limit');});"],"type":"text/javascript"}}]}
    ]},
    {"name":"02 Repositories","item":[
      {"name":"Search with query parameters — 200","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"},{"key":"X-Request-ID","value":"postman-search-{{$randomUUID}}"}],"url":{"raw":"{{baseUrl}}/repositories/search?q={{query}}&language={{language}}&sort=stars&order=desc&page={{page}}&per_page={{perPage}}","host":["{{baseUrl}}"],"path":["repositories","search"],"query":[{"key":"q","value":"{{query}}"},{"key":"language","value":"{{language}}"},{"key":"sort","value":"stars"},{"key":"order","value":"desc"},{"key":"page","value":"{{page}}"},{"key":"per_page","value":"{{perPage}}"}]}},"event":[{"listen":"test","script":{"exec":["pm.test('Status 200',()=>pm.response.to.have.status(200));","const j=pm.response.json(); pm.test('Paginated structure',()=>{pm.expect(j.items).to.be.an('array');pm.expect(j.page).to.eql(Number(pm.environment.get('page')));pm.expect(j).to.have.property('total_count');});","if(j.items.length){const p=j.items[0].full_name.split('/');pm.collectionVariables.set('sampleOwner',p[0]);pm.collectionVariables.set('sampleRepo',p[1]);}"],"type":"text/javascript"}}]},
      {"name":"Repository details — 200","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":"{{baseUrl}}/repositories/{{owner}}/{{repo}}"},"event":[{"listen":"test","script":{"exec":["pm.test('Status 200',()=>pm.response.to.have.status(200));","const j=pm.response.json();pm.test('Repository contract',()=>{pm.expect(j).to.include.keys('id','name','full_name','owner','stargazers_count','health_score');pm.expect(j.owner).to.have.property('login');pm.expect(j.health_score).to.be.within(0,100);});"],"type":"text/javascript"}}]},
      {"name":"Languages — 200","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":"{{baseUrl}}/repositories/{{owner}}/{{repo}}/languages"},"event":[{"listen":"test","script":{"exec":["pm.test('Status 200',()=>pm.response.to.have.status(200));","pm.test('Languages object',()=>pm.expect(pm.response.json().languages).to.be.an('object'));"],"type":"text/javascript"}}]},
      {"name":"Contributors page — 200","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":"{{baseUrl}}/repositories/{{owner}}/{{repo}}/contributors?page=1&per_page=5"},"event":[{"listen":"test","script":{"exec":["pm.test('Status 200',()=>pm.response.to.have.status(200));","pm.test('Items array',()=>pm.expect(pm.response.json().items).to.be.an('array'));"],"type":"text/javascript"}}]},
      {"name":"Issues without pull requests — 200","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":"{{baseUrl}}/repositories/{{owner}}/{{repo}}/issues?page=1&per_page=10"},"event":[{"listen":"test","script":{"exec":["pm.test('Status 200',()=>pm.response.to.have.status(200));","const j=pm.response.json();pm.test('No pull_request fields',()=>j.items.forEach(x=>pm.expect(x).not.to.have.property('pull_request')));"],"type":"text/javascript"}}]},
      {"name":"Releases — 200","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":"{{baseUrl}}/repositories/{{owner}}/{{repo}}/releases?page=1&per_page=5"},"event":[{"listen":"test","script":{"exec":["pm.test('Status 200',()=>pm.response.to.have.status(200));","pm.test('Page metadata',()=>pm.expect(pm.response.json()).to.include.keys('items','page','per_page','has_next'));"],"type":"text/javascript"}}]},
      {"name":"Invalid search query — 422","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":"{{baseUrl}}/repositories/search?q=x&page=0"},"event":[{"listen":"test","script":{"exec":["pm.test('Status 422',()=>pm.response.to.have.status(422));","pm.test('Unified error',()=>pm.expect(pm.response.json().error).to.include.keys('code','message','request_id'));"],"type":"text/javascript"}}]},
      {"name":"Missing repository — 404","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":"{{baseUrl}}/repositories/reposcope-does-not-exist-404/missing"},"event":[{"listen":"test","script":{"exec":["pm.test('Status 404',()=>pm.response.to.have.status(404));","pm.test('Code github_not_found',()=>pm.expect(pm.response.json().error.code).to.eql('github_not_found'));"],"type":"text/javascript"}}]}
    ]},
    {"name":"03 Favorite lifecycle","description":"Последовательный сценарий: очистка → 201 → 409 → GET → 204 → 404.","item":[
      {"name":"Pre-clean favorite — 204 or 404","request":{"method":"DELETE","header":[{"key":"Accept","value":"application/json"}],"url":"{{baseUrl}}/favorites/{{owner}}/{{repo}}"},"event":[{"listen":"test","script":{"exec":["pm.test('Pre-clean accepted',()=>pm.expect([204,404]).to.include(pm.response.code));"],"type":"text/javascript"}}]},
      {"name":"Create favorite — 201","request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"owner\": \"{{owner}}\",\n  \"repo\": \"{{repo}}\"\n}","options":{"raw":{"language":"json"}}},"url":"{{baseUrl}}/favorites"},"event":[{"listen":"test","script":{"exec":["pm.test('Status 201',()=>pm.response.to.have.status(201));","pm.test('Location present',()=>pm.expect(pm.response.headers.get('Location')).to.match(/^\\/api\\/v1\\/favorites\\//));","const j=pm.response.json();pm.test('Favorite shape',()=>pm.expect(j).to.include.keys('id','owner','repo','full_name','created_at'));pm.environment.set('favoriteLocation',pm.response.headers.get('Location'));"],"type":"text/javascript"}}]},
      {"name":"Duplicate favorite — 409","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"owner\":\"{{owner}}\",\"repo\":\"{{repo}}\"}","options":{"raw":{"language":"json"}}},"url":"{{baseUrl}}/favorites"},"event":[{"listen":"test","script":{"exec":["pm.test('Status 409',()=>pm.response.to.have.status(409));","pm.test('Duplicate code',()=>pm.expect(pm.response.json().error.code).to.eql('favorite_exists'));"],"type":"text/javascript"}}]},
      {"name":"List includes favorite — 200","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":"{{baseUrl}}/favorites"},"event":[{"listen":"test","script":{"exec":["pm.test('Status 200',()=>pm.response.to.have.status(200));","const j=pm.response.json();pm.test('Created favorite is present',()=>pm.expect(j.items.some(x=>x.owner.toLowerCase()===pm.environment.get('owner').toLowerCase()&&x.repo.toLowerCase()===pm.environment.get('repo').toLowerCase())).to.be.true);"],"type":"text/javascript"}}]},
      {"name":"Delete favorite — 204","request":{"method":"DELETE","header":[{"key":"Accept","value":"application/json"}],"url":"{{baseUrl}}/favorites/{{owner}}/{{repo}}"},"event":[{"listen":"test","script":{"exec":["pm.test('Status 204',()=>pm.response.to.have.status(204));","pm.test('Empty body',()=>pm.expect(pm.response.text()).to.eql(''));"],"type":"text/javascript"}}]},
      {"name":"Delete missing favorite — 404","request":{"method":"DELETE","header":[{"key":"Accept","value":"application/json"}],"url":"{{baseUrl}}/favorites/{{owner}}/{{repo}}"},"event":[{"listen":"test","script":{"exec":["pm.test('Status 404',()=>pm.response.to.have.status(404));","pm.test('Not found code',()=>pm.expect(pm.response.json().error.code).to.eql('favorite_not_found'));"],"type":"text/javascript"}}]},
      {"name":"Malformed JSON — 400","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"owner\":","options":{"raw":{"language":"json"}}},"url":"{{baseUrl}}/favorites"},"event":[{"listen":"test","script":{"exec":["pm.test('Status 400',()=>pm.response.to.have.status(400));","pm.test('Invalid JSON code',()=>pm.expect(pm.response.json().error.code).to.eql('invalid_json'));"],"type":"text/javascript"}}]}
    ]}
  ],
  "variable": [
    {"key":"sampleOwner","value":"golang"},
    {"key":"sampleRepo","value":"go"}
  ]
}
